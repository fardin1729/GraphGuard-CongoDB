# CognoDB / Neo4j Bolt Connection Credentials
# CognoDB Cloud uses Bolt protocol (compatible with neo4j:// or bolt://)
COGNO_URI=bolt://localhost:7687
COGNO_USER=neo4j
COGNO_PASSWORD=password
DATABASE_NAME=neo4j

# Application Environment & Server Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
ENABLE_DEMO_FALLBACK=true
